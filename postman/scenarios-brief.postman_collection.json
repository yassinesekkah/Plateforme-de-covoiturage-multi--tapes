                  "raw": "{\n  \"firstName\": \"Hamid\",\n  \"lastName\": \"Alami\",\n  \"email\": \"cov20.hamid@example.com\",\n  \"phone\": \"0600000001\",\n  \"licenseNumber\": \"COV20-HAMID-001\"\n}",
