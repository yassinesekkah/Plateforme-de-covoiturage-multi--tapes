        {
          "name": "Publier un trajet - 201",
          "request": {
            "method": "POST",
            "url": "http://localhost:8080/api/conducteurs/1/trajets",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Conducteur-Id",
                "value": "1"
              }
            ],
            "description": "Conducteur 1 et vehicule 1 doivent exister ; le vehicule appartient au conducteur 1 et a au moins 3 places. Adapter les ids et dates manuellement. Chaque POST valide cree un nouveau trajet.",
