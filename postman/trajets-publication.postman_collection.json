              "mode": "raw",
              "raw": "{\n  \"vehiculeId\": 1,\n  \"offeredSeats\": 3,\n  \"pointsArret\": [\n    {\n      \"city\": \"Rabat\",\n      \"passageTime\": \"2026-12-01T17:00:00\",\n      \"priceFromDeparture\": 0\n    },\n    {\n      \"city\": \"Casablanca\",\n      \"passageTime\": \"2026-12-01T18:15:00\",\n      \"priceFromDeparture\": 40\n    },\n    {\n      \"city\": \"Marrakech\",\n      \"passageTime\": \"2026-12-01T21:30:00\",\n      \"priceFromDeparture\": 120\n    }\n  ]\n}",
