  "item": [
    {
      "name": "Reservations - Creation COV-15",
      "description": "Sans variables ni scripts. Adapter manuellement tous les ids. Lire docs/tests-reservations.md. Trajet 1 : PUBLIE, 4 places, points 1 Rabat 0 DH, 2 Casablanca 40 DH, 3 Settat 70 DH, 4 Marrakech 120 DH. Point 5 sur trajet 2. Passagers 1 a 4 existants. Executer refus avant scenario succes ; ne pas relancer le scenario sur un trajet deja reserve.",
      "item": [
        {
          "name": "0 - Preparer les donnees",
          "item": [
            {
              "name": "Voir les passagers - 200",
              "request": {
                "method": "GET",
                "url": "http://localhost:8080/api/passagers",
                "header": [],
                "description": "Choisir quatre profils ; creer les profils manquants avec le dossier Passagers. Reporter leurs vrais ids dans les URLs et headers Reservation."
              }
            },
            {
              "name": "Voir les vehicules du conducteur - 200",
              "request": {
                "method": "GET",
                "url": "http://localhost:8080/api/conducteurs/1/vehicules",
                "header": [],
                "description": "Adapter conducteur 1 ; choisir son vehicule de capacite au moins 4."
              }
            },
            {
              "name": "Publier trajet quatre points - 201",
              "request": {
                "method": "POST",
                "url": "http://localhost:8080/api/conducteurs/1/trajets",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  },
                  {
                    "key": "X-Conducteur-Id",
                    "value": "1"
                  }
                ],
                "description": "Adapter conducteur, vehicule et dates futures. Conserver id du trajet et ids des quatre points de la reponse ; les reporter manuellement dans les requetes Reservation. Rejouer cette publication pour creer le second trajet du test de points etrangers.",
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"vehiculeId\": 1,\n  \"offeredSeats\": 4,\n  \"pointsArret\": [\n    {\n      \"city\": \"Rabat\",\n      \"passageTime\": \"2026-12-01T17:00:00\",\n      \"priceFromDeparture\": 0\n    },\n    {\n      \"city\": \"Casablanca\",\n      \"passageTime\": \"2026-12-01T18:15:00\",\n      \"priceFromDeparture\": 40\n    },\n    {\n      \"city\": \"Settat\",\n      \"passageTime\": \"2026-12-01T19:00:00\",\n      \"priceFromDeparture\": 70\n    },\n    {\n      \"city\": \"Marrakech\",\n      \"passageTime\": \"2026-12-01T21:30:00\",\n      \"priceFromDeparture\": 120\n    }\n  ]\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                }
              }
            }
          ]
        },
