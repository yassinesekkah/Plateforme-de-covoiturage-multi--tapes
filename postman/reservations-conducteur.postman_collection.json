            "method": "GET",
            "url": "http://localhost:8080/api/conducteurs/2/trajets/1/reservations",
            "header": [
              {
                "key": "X-Conducteur-Id",
                "value": "2"
              }
            ],
            "description": "Conducteur 2 existe mais trajet 1 appartient au conducteur 1 : refus."
          }
        },
        {
