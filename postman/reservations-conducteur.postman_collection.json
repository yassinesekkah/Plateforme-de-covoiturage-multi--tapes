{
  "info": {
    "name": "Covoiturage - Reservations conducteur",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Reservations - Lecture conducteur COV-16",
      "description": "Aucun body. Adapter manuellement tous les ids. Conducteurs 1 et 2 existent ; trajet 1 appartient au conducteur 1 ; trajet 2 aussi, mais sans reservations pour le test de liste vide. Les chiffres sont des exemples. La lecture inclut CONFIRMEE et ANNULEE et reste disponible pour les trajets termines/annules.",
      "item": [
        {
          "name": "Reservations de mon trajet - 200",
          "request": {
            "method": "GET",
            "url": "http://localhost:8080/api/conducteurs/1/trajets/1/reservations",
            "header": [
              {
                "key": "X-Conducteur-Id",
                "value": "1"
              }
            ],
            "description": "Liste du trajet 1 uniquement, avec passagerId, trajet, montee/descente et villes/heures, places, montant, date et statut. Tri dateReservation puis id decroissants."
          }
        },
        {
          "name": "Mon trajet sans reservations - 200",
          "request": {
            "method": "GET",
            "url": "http://localhost:8080/api/conducteurs/1/trajets/2/reservations",
            "header": [
              {
                "key": "X-Conducteur-Id",
                "value": "1"
              }
            ],
            "description": "Trajet 2 doit exister, appartenir au conducteur 1 et ne pas avoir de reservations. Attendu []."
          }
        },
        {
          "name": "Autre acteur - 403",
          "request": {
            "method": "GET",
            "url": "http://localhost:8080/api/conducteurs/1/trajets/1/reservations",
